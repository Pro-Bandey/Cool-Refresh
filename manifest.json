{
  "manifest_version": 3,
  "name": "Cool Refresh",
  "version": "12.0.0",
  "description": "Customizable pull-to-refresh instead of the built-in one.",

  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_icons": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },

  "permissions": ["storage", "tabs"],

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "cool-refresh@pro-bandey.com",
      "strict_min_version": "146.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "146.0"
    }
  }
}
